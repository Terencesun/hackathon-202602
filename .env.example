# Node environment development or production
NODE_ENV=development

# Tick processing concurrency (API)
# Controls how many agents are processed in parallel per tick
TICK_CONCURRENCY=4

# Supabase Configuration
# Retrieve these from your Supabase Project Settings -> API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-key

# SecondMe API Configuration
SECONDME_CLIENT_ID=your-client-id
SECONDME_CLIENT_SECRET=your-client-secret
SECONDME_REDIRECT_URI=http://localhost:5173/auth/callback
SECONDME_API_URL=https://app.mindos.com/gate/lab

# Frontend (Vite) exposure for OAuth
VITE_SECONDME_CLIENT_ID=your-client-id
VITE_SECONDME_REDIRECT_URI=http://localhost:5173/auth/callback
 
# Frontend API base URL
# If set to a path (e.g., /api), the current origin is used
VITE_API_URL=/api

# JWT Secret
JWT_SECRET=your-secure-jwt-secret

# Auth cookie name (HttpOnly cookie key)
COOKIE_KEY_NAME=adv
